# Chave da Anthropic (crie em https://console.anthropic.com). Usada APENAS no servidor.
ANTHROPIC_API_KEY=sk-ant-...

# SQLite local (para Postgres, troque o provider no schema.prisma e use a URL do Postgres)
DATABASE_URL="file:./dev.db"

# Segredo do NextAuth. Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=troque-por-um-segredo-longo
NEXTAUTH_URL=http://localhost:3000

# Opcional: modelo do Claude usado pelo tutor e pelo gerador de lições
# ANTHROPIC_MODEL=claude-sonnet-5-5
